-- game.script
-- Main gameplay controller: grid state, aiming, shooting, matching, pause/game-over.

local constants = require("game.constants")
local hexgrid = require("game.hexgrid")

--------------------------------------------------------------------------
-- helpers
--------------------------------------------------------------------------

local function bubble_sprite_url(id)
	return msg.url(nil, id, "sprite")
end

local function random_mob(self)
	return constants.MOB_TYPES[math.random(1, self.active_mob_count)]
end

local function spawn_bubble_at(self, row, col, mob)
	local x, y = hexgrid.cell_to_pos(row, col)
	local id = factory.create("#bubble_factory", vmath.vector3(x, y, 0), nil, {}, 1)
	msg.post(bubble_sprite_url(id), "play_animation", { id = hash(mob) })
	self.grid[row] = self.grid[row] or {}
	self.grid[row][col] = { url = id, mob = mob }
	return id
end

local function clear_grid(self)
	for row, cols in pairs(self.grid) do
		for col, cell in pairs(cols) do
			if cell then
				go.delete(cell.url)
			end
		end
	end
	self.grid = {}
end

local function spawn_initial_grid(self)
	for row = 1, constants.INITIAL_ROWS do
		local cols = hexgrid.cols_in_row(row)
		for col = 1, cols do
			spawn_bubble_at(self, row, col, random_mob(self))
		end
	end
end

local function update_score_hud(self)
	msg.post("hud#gui", "update_score", { score = self.score })
end

local function update_ammo_hud(self)
	msg.post("hud#gui", "update_current", { mob = self.current_mob })
	msg.post("hud#gui", "update_next", { mob = self.next_mob })
end

local function prepare_next_shot(self)
	self.current_mob = self.next_mob
	self.next_mob = random_mob(self)
	update_ammo_hud(self)
end

local function flood_same_type(self, row, col, mob)
	local visited = {}
	local stack = { { row, col } }
	local result = {}
	visited[row .. "_" .. col] = true
	while #stack > 0 do
		local cell = table.remove(stack)
		local r, c = cell[1], cell[2]
		table.insert(result, { r, c })
		for _, n in ipairs(hexgrid.neighbors(r, c)) do
			local nr, nc = n[1], n[2]
			local key = nr .. "_" .. nc
			if not visited[key] and self.grid[nr] and self.grid[nr][nc]
					and self.grid[nr][nc].mob == mob then
				visited[key] = true
				table.insert(stack, { nr, nc })
			end
		end
	end
	return result
end

local function find_floating(self)
	local connected = {}
	local stack = {}
	if self.grid[1] then
		for col, cell in pairs(self.grid[1]) do
			if cell then
				table.insert(stack, { 1, col })
				connected["1_" .. col] = true
			end
		end
	end
	while #stack > 0 do
		local cur = table.remove(stack)
		local r, c = cur[1], cur[2]
		for _, n in ipairs(hexgrid.neighbors(r, c)) do
			local nr, nc = n[1], n[2]
			local key = nr .. "_" .. nc
			if not connected[key] and self.grid[nr] and self.grid[nr][nc] then
				connected[key] = true
				table.insert(stack, { nr, nc })
			end
		end
	end
	local floating = {}
	for r, row in pairs(self.grid) do
		for c, cell in pairs(row) do
			if cell and not connected[r .. "_" .. c] then
				table.insert(floating, { r, c })
			end
		end
	end
	return floating
end

local function check_game_over(self)
	for r, row in pairs(self.grid) do
		for c, cell in pairs(row) do
			if cell then
				local _, y = hexgrid.cell_to_pos(r, c)
				if y <= constants.GAMEOVER_Y then
					self.game_over = true
					msg.post("hud#gui", "show_game_over", { score = self.score })
					return
				end
			end
		end
	end
end

local function resolve_matches(self, row, col, mob)
	local matched = flood_same_type(self, row, col, mob)
	if #matched >= 3 then
		for _, cell in ipairs(matched) do
			local r, c = cell[1], cell[2]
			local entry = self.grid[r][c]
			go.delete(entry.url)
			self.grid[r][c] = nil
			self.score = self.score + 10
		end
		local floating = find_floating(self)
		for _, cell in ipairs(floating) do
			local r, c = cell[1], cell[2]
			local entry = self.grid[r][c]
			go.delete(entry.url)
			self.grid[r][c] = nil
			self.score = self.score + 15
		end
		update_score_hud(self)
	end
end

local function push_ceiling_down(self)
	local max_row = 0
	for r, _ in pairs(self.grid) do
		if r > max_row then
			max_row = r
		end
	end
	for r = max_row, 1, -1 do
		self.grid[r + 1] = self.grid[r]
	end
	self.grid[1] = nil

	for r, row in pairs(self.grid) do
		if r > 1 then
			for c, cell in pairs(row) do
				if cell then
					local x, y = hexgrid.cell_to_pos(r, c)
					go.set_position(vmath.vector3(x, y, 0), cell.url)
				end
			end
		end
	end

	local cols = hexgrid.cols_in_row(1)
	self.grid[1] = {}
	for c = 1, cols do
		spawn_bubble_at(self, 1, c, random_mob(self))
	end
	check_game_over(self)
end

local function reset_shooter_visual(self)
	go.set_rotation(vmath.quat_rotation_z(0), "shooter")
	msg.post("shooter#sprite", "play_animation", { id = hash("bow") })
end

local function set_aim_angle(self, deg)
	self.aim_deg = deg
	local rad = math.rad(deg - 90)
	go.set_rotation(vmath.quat_rotation_z(rad), "shooter")
end

local function update_aim(self, x, y)
	local dx = x - constants.SHOOTER_X
	local dy = y - constants.SHOOTER_Y
	local deg = math.deg(math.atan(dy, dx))
	if deg < constants.AIM_MIN_DEG then
		deg = constants.AIM_MIN_DEG
	elseif deg > constants.AIM_MAX_DEG then
		deg = constants.AIM_MAX_DEG
	end
	set_aim_angle(self, deg)
	msg.post("shooter#sprite", "play_animation", { id = hash("bow_pulled") })
end

local function fire_shot(self)
	local rad = math.rad(self.aim_deg)
	local dir = vmath.vector3(math.cos(rad), math.sin(rad), 0)
	local start_pos = vmath.vector3(constants.SHOOTER_X, constants.SHOOTER_Y, 0) + dir * (constants.RADIUS + 40)
	local id = factory.create("#bubble_factory", start_pos, nil, {}, 1)
	msg.post(bubble_sprite_url(id), "play_animation", { id = hash(self.current_mob) })
	self.projectile = {
		url = id,
		mob = self.current_mob,
		vel = dir * constants.SHOT_SPEED,
	}
	self.shots_fired = self.shots_fired + 1
	reset_shooter_visual(self)
	prepare_next_shot(self)
end

local function land_projectile(self)
	local p = self.projectile
	local pos = go.get_position(p.url)
	local row, col = hexgrid.nearest_cell(self.grid, pos.x, pos.y)
	if row == nil then
		-- grid full at this height, just drop it (shouldn't normally happen)
		go.delete(p.url)
		self.projectile = nil
		return
	end
	local x, y = hexgrid.cell_to_pos(row, col)
	go.set_position(vmath.vector3(x, y, 0), p.url)
	self.grid[row] = self.grid[row] or {}
	self.grid[row][col] = { url = p.url, mob = p.mob }
	self.projectile = nil

	resolve_matches(self, row, col, p.mob)
	check_game_over(self)

	if not self.game_over and self.shots_fired % constants.SHOTS_PER_CEILING_DROP == 0 then
		push_ceiling_down(self)
	end
end

--------------------------------------------------------------------------
-- lifecycle
--------------------------------------------------------------------------

local function start_new_game(self)
	clear_grid(self)
	self.score = 0
	self.shots_fired = 0
	self.game_over = false
	self.paused = false
	self.aiming = false
	self.projectile = nil
	self.active_mob_count = constants.ACTIVE_MOB_COUNT
	self.aim_deg = 90
	math.randomseed(os.time())

	spawn_initial_grid(self)
	self.current_mob = random_mob(self)
	self.next_mob = random_mob(self)

	reset_shooter_visual(self)
	update_score_hud(self)
	update_ammo_hud(self)
	msg.post("hud#gui", "hide_overlay")
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.grid = {}
	start_new_game(self)
end

function final(self)
	clear_grid(self)
end

function update(self, dt)
	if self.paused or self.game_over then
		return
	end
	if self.projectile then
		local p = self.projectile
		local pos = go.get_position(p.url)
		pos = pos + p.vel * dt

		if pos.x - constants.RADIUS < 0 then
			pos.x = constants.RADIUS
			p.vel.x = -p.vel.x
		elseif pos.x + constants.RADIUS > constants.SCREEN_W then
			pos.x = constants.SCREEN_W - constants.RADIUS
			p.vel.x = -p.vel.x
		end
		go.set_position(pos, p.url)

		local should_land = false
		if pos.y >= constants.GRID_TOP_Y + constants.ROW_H * 0.5 then
			should_land = true
		else
			for r, row in pairs(self.grid) do
				for c, cell in pairs(row) do
					if cell then
						local cx, cy = hexgrid.cell_to_pos(r, c)
						local dx, dy = pos.x - cx, pos.y - cy
						local touch = (constants.RADIUS * 1.75)
						if dx * dx + dy * dy <= touch * touch then
							should_land = true
						end
					end
				end
			end
		end

		if should_land then
			land_projectile(self)
		end
	end
end

function on_input(self, action_id, action)
	if self.game_over or self.paused then
		return
	end

	if action_id == hash("back") and action.released then
		msg.post(".", "request_pause")
		return
	end

	if action_id ~= hash("touch") then
		return
	end

	if self.projectile ~= nil then
		return
	end

	if action.pressed then
		self.aiming = true
		update_aim(self, action.x, action.y)
	elseif action.released then
		if self.aiming then
			fire_shot(self)
		end
		self.aiming = false
	elseif self.aiming then
		update_aim(self, action.x, action.y)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("request_pause") then
		if not self.game_over then
			self.paused = true
			self.aiming = false
			reset_shooter_visual(self)
			msg.post("hud#gui", "show_pause")
		end

	elseif message_id == hash("request_resume") then
		self.paused = false
		msg.post("hud#gui", "hide_overlay")

	elseif message_id == hash("request_restart") then
		start_new_game(self)

	elseif message_id == hash("request_quit_to_menu") then
		clear_grid(self)
		msg.post("main:/loader#loader", "return_to_menu")
	end
end
