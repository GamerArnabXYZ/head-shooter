; Engine configuration file.
; Godot 3.5.x project — GLES2 renderer for low-end Android + WebGL1.0.

config_version=4

_global_script_classes=[]
_global_script_class_icons={}

[application]

config/name="Minecraft Head Shooter"
config/description="A Minecraft-styled bubble shooter — match 3+ mob heads to pop them."
run/main_scene="res://scenes/home/Home.tscn"
config/icon="res://icon.png"

[autoload]

Globals="*res://autoload/Globals.gd"

[display]

window/size/width=720
window/size/height=1280
window/stretch/mode="2d"
window/stretch/aspect="keep"
window/handheld/orientation="portrait"
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom="res://theme/GameTheme.tres"

[input]

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_environment="res://default_env.tres"
quality/2d/use_pixel_snap=true
